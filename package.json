{
  "name": "@putuwahyu29/backup-puller-worker",
  "version": "1.0.0",
  "description": "Universal, reusable backup puller, QNAP, and WebDAV uploader microservice for Laravel applications",
  "homepage": "https://github.com/putuwahyu29/backup-puller-worker",
  "repository": {
    "type": "git",
