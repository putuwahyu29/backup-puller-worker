# ==============================================================================
# BPS UNIVERSAL BACKUP PULLER WORKER (.env)
# ==============================================================================

# Mode: 'single' (menggunakan setting di bawah) atau 'multi' (menggunakan apps.json)
WORKER_MODE=single

# Pilihan Driver Storage Tujuan: 'qnap' atau 'webdav'
STORAGE_DRIVER=qnap

# Nama aplikasi dan service identifier (muncul di audit service-reports)
APP_NAME=kadiri
SERVICE_NAME=backup-puller-kadiri

# URL Base aplikasi Laravel & API Key (header X-API-Key)
APP_API_BASE_URL=http://localhost:8000
APP_API_KEY=bk_your_generated_secret_api_key_here

# Path endpoint di Laravel
APP_BACKUP_METADATA_PATH=/api/backups/latest/metadata
APP_BACKUP_DOWNLOAD_PATH=/api/backups/latest/download
APP_SERVICE_REPORT_PATH=/api/service-reports

# Tipe backup yang akan ditarik (dipisah koma)
BACKUP_TYPES=database,attachments

# Paksa generate backup baru di sisi aplikasi (?fresh=1)
BACKUP_FRESH=false

# Nonaktifkan verifikasi TLS jika menggunakan self-signed cert
APP_TLS_REJECT_UNAUTHORIZED=false

# Kebijakan upload:
# - 'dedupe': Upload jika SHA-256 berbeda dari upload sebelumnya
# - 'daily': Maksimal 1 upload sukses per hari (berdasarkan BACKUP_TIMEZONE)
# - 'force': Selalu upload ulang
UPLOAD_POLICY=dedupe
BACKUP_TIMEZONE=Asia/Jakarta

# ==============================================================================
# PILIHAN 1: QNAP NAS CONFIGURATION (jika STORAGE_DRIVER=qnap)
# ==============================================================================
QNAP_HOST=http://qnap.local:8080
QNAP_USERNAME=admin
QNAP_PASSWORD=replace-with-qnap-password
QNAP_DEST_PATH=/home/backup/kadiri
QNAP_TLS_REJECT_UNAUTHORIZED=true

# ==============================================================================
# PILIHAN 2: WEBDAV / NEXTCLOUD CONFIGURATION (jika STORAGE_DRIVER=webdav)
# ==============================================================================
# Contoh Nextcloud: https://cloud.example.com/remote.php/dav/files/admin
# Contoh WebDAV NAS / Apache: http://nas.local:5005/webdav
WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/admin
WEBDAV_USERNAME=admin
WEBDAV_PASSWORD=replace-with-webdav-password-or-app-token
WEBDAV_DEST_PATH=/backup/kadiri
WEBDAV_AUTH_TYPE=basic
WEBDAV_TLS_REJECT_UNAUTHORIZED=true

# ==============================================================================
# OPERATIONAL & SCHEDULING
# ==============================================================================
# 0 = Jalankan 1 kali lalu exit (mode one-off / cron), >0 = Jalankan looping setiap X menit
RUN_INTERVAL_MINUTES=60

# Kompresi & Penyimpanan Lokal
UPLOAD_AS_ZIP=true
ZIP_COMPRESSION_LEVEL=9
KEEP_LOCAL_FILE=false
WORK_DIR=./runtime/temp
STATE_DIR=./runtime/state
REQUEST_TIMEOUT_MS=180000

# ==============================================================================
# MULTI-APP FLEET CONFIGURATION (OPSIONAL)
# ==============================================================================
# Jika diisi, worker akan memproses seluruh aplikasi dalam file JSON ini:
# APPS_CONFIG_PATH=./config/apps.json
